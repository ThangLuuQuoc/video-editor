{
  "name": "ai-video-director",
  "version": "0.1.0",
  "private": true,
  "description": "Script-to-Video Director đa mô hình (không phụ thuộc Google Flow) — hỗ trợ MCP, ACP và Skill Library",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/cli.ts serve",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "acp": "tsx src/cli.ts acp",
    "make": "tsx src/cli.ts make",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "tsx": "^4.20.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
